# Enable the API TURN entry and start compose with: docker compose --profile turn up -d
TURN_ENABLED=true
TURN_REALM=turn.example.invalid
TURN_EXTERNAL_IP=<PUBLIC_VPS_IP>
TURN_SHARED_SECRET=<DISPOSABLE_OR_PRODUCTION_SECRET>
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49260

# Browser-reachable URL, not the Docker service hostname.
WEBRTC_TURN_URL=turn:turn.example.invalid:3478
WEBRTC_TURN_TCP_URL=turn:turn.example.invalid:3478?transport=tcp
WEBRTC_STUN_URL=stun:turn.example.invalid:3478
WEBRTC_TURN_SHARED_SECRET=<SAME_VALUE_AS_TURN_SHARED_SECRET>
WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600
